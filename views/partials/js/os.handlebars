        // ---------- OS updates / upgrades (v3.5.0) ----------
        //
        // Since issue #9 this area has NO panel of its own: the OS state and every OS action live on the row of
        // each device in Devices > Device list, and the OS update log is at the bottom of that page. What stays
        // here are the ACTIONS and the text formatters, so there is exactly one definition of what an OS update,
        // an upgrade, a Windows Update repair, a user notice or a restart asks and does - the device list calls
        // these functions and never re-implements them.

        var osApp = { status: null };

        /** @brief Refresh whatever view shows the OS state - since issue #9 that is the device list. */
        function osRefresh() {
            if (typeof loadDeviceList === 'function') { loadDeviceList(); }
        }

        function osLastText(d) {
            if (d.pending) { return 'running (' + esc(d.pending.mode) + ') since ' + esc(new Date(d.pending.since || Date.now()).toLocaleTimeString()); }
            var l = d.last;
            if (!l) { return '-'; }
            var t = esc(fmtLocal(l.time)) + ' - ' + esc(l.mode || '') + ': ';
            if (l.error) { return t + '<span style="color:#a33">' + esc(l.error) + '</span>'; }
            var col = (l.state === 'ok') ? '#1d7a3a' : ((l.state === 'reboot-needed' || l.state === 'unsupported') ? '#8a6d3b' : '#a33');
            t += '<span style="color:' + col + '">' + esc(l.state) + '</span>';
            if (l.platform === 'windows') { t += ', ' + (l.installed || 0) + '/' + (l.found || 0) + ' installed' + (l.failed ? ', ' + l.failed + ' failed' : ''); }
            else { t += ' (' + esc(l.pm || '?') + (l.step ? ', ' + esc(l.step) : '') + (l.exit != null ? ', exit ' + esc(l.exit) : '') + ')'; }
            if (l.reboot) { t += ' <b style="color:#a33">reboot pending</b>'; }
            if (l.note) { t += '<div style="font-size:11px;color:#556">' + esc(l.note) + '</div>'; }
            return t;
        }

        function osWuText(d) {
            if (d.wuPending) { return '<div style="font-size:11px;color:#8a6d3b">Windows Update troubleshooter: ' + esc(d.wuPending.kind === 'repair' ? 'repairing' : 'diagnosing') + '…</div>'; }
            var w = d.wu;
            if (!w) { return ''; }
            var col = w.state === 'ok' ? '#1d7a3a' : (w.state === 'partial' ? '#8a6d3b' : (w.state === 'timeout' ? '#a33' : '#888'));
            var t = '<div style="font-size:11px;margin-top:2px;border-top:1px solid #eee;padding-top:2px"><b>WU ' + esc(w.kind === 'repair' ? 'repair' : 'check') + ':</b> <span style="color:' + col + '">' + esc(w.state || '') + '</span>';
            if (w.kind === 'diag' && Array.isArray(w.services)) { var st = w.services.filter(function (x) { return x.status && x.status !== 'Running'; }); if (st.length) { t += ' (' + st.length + ' service(s) not running)'; } if (Array.isArray(w.events) && w.events.length) { t += ' (' + w.events.length + ' recent error(s) in the WU log)'; } }
            else if (w.kind === 'repair' && Array.isArray(w.steps)) { var okn = w.steps.filter(function (x) { return x.ok; }).length; t += ' (' + okn + '/' + w.steps.length + ' steps ok)'; }
            if (w.rebootPending) { t += ' <b style="color:#c80">reboot pending</b>'; }
            if (w.rebootNote) { t += '<div style="color:#556">' + esc(w.rebootNote) + '</div>'; }
            return t + '</div>';
        }

        function rbText(d) {
            if (d.rbPending) { return '<div style="font-size:11px;color:#8a6d3b">restart/notice ' + esc(d.rbPending.kind) + ' running…</div>'; }
            var rb = d.rb;
            if (!rb || (!rb.state && !rb.kind)) { return ''; }
            var col = rb.state === 'scheduled' || rb.state === 'sent' || rb.state === 'rebooted' ? '#1d7a3a' : (rb.state === 'not-delivered' ? '#8a6d3b' : '#a33');
            var lbl = (rb.kind === 'notify') ? 'notice' : 'restart';
            var t = '<div style="font-size:11px;margin-top:2px;border-top:1px solid #eee;padding-top:2px"><b>' + esc(lbl) + ':</b> <span style="color:' + col + '">' + esc(rb.state) + '</span> ' + esc(fmtLocal(rb.time));
            if (rb.kind === 'reboot' && rb.secs != null && rb.state === 'scheduled') { t += ' (in ' + esc(rb.secs) + 's, abort: ' + esc(rb.abort || '') + ')'; }
            if (rb.users) { t += ' <span style="color:#556">user: ' + esc(rb.users) + '</span>'; }
            if (rb.pendingReboot) { t += ' <b style="color:#c80">reboot was already pending (' + esc(rb.source || '') + ')</b>'; }
            return t + '</div>';
        }

        function osDevLabel(id) {
            var ds = (osApp.status && osApp.status.devices) || [];
            for (var i = 0; i < ds.length; i++) { if (ds[i].id === id) { return ds[i].given || ds[i].host || id; } }
            return id;
        }

        function osRun(mode, nodeId, scope) {
            var body = { mode: mode };
            if (nodeId) { body.nodeIds = nodeId; }
            if (scope) { body.scope = scope; }
            post('os_run', body).then(function (d) {
                if (d.error) { showMsg('osMsg', d.error, false); return; }
                if (d.busy) { floatMsg('A winget or OS batch is still running - try again later.', false); return; }
                floatMsg('OS ' + mode + (scope ? ' (' + scope + ')' : '') + ' started' + (nodeId ? ' for ' + osDevLabel(nodeId) : '') + ' - the row state and the OS update log fill in as it runs.', true);
                setTimeout(osRefresh, 1500);
            }).catch(function (ex) { showMsg('osMsg', 'Run failed: ' + ex.message, false); });
        }

        function wuDiag(nodeId) {
            post('wu_diag', { nodeId: nodeId }).then(function (d) {
                if (d.error) { showMsg('osMsg', d.error, false); return; }
                floatMsg('Windows Update diagnose started for ' + osDevLabel(nodeId) + ' - open Details on the row to read it (changes nothing).', true);
                setTimeout(osRefresh, 2000);
            }).catch(function (ex) { showMsg('osMsg', 'Diagnose failed: ' + ex.message, false); });
        }

        function wuRepair(nodeId) {
            post('wu_repair', { nodeId: nodeId }).then(function (d) {
                if (d.error) { showMsg('osMsg', d.error, false); return; }
                floatMsg('Windows Update repairs started for ' + osDevLabel(nodeId) + ' - no reboot is triggered; a pending reboot (if any) is reported.', true);
                setTimeout(osRefresh, 2500);
            }).catch(function (ex) { showMsg('osMsg', 'Repair failed: ' + ex.message, false); });
        }

        function rbRestart(nodeId) {
            var m = window.prompt('Message to show the logged-on user (a 60s restart countdown is started; save-your-work notice). Cancel to abort.', 'A maintenance restart was triggered by the administrator - please save your work.');
            if (m === null) { return; }
            var name = window.prompt('Type the device name exactly to confirm the restart of ' + osDevLabel(nodeId) + ':', '');
            if (name === null) { return; }
            post('reboot_now', { nodeId: nodeId, secs: 60, message: m, confirm: name }).then(function (d) {
                if (d.error) { showMsg('osMsg', d.error, false); return; }
                floatMsg('Restart scheduled on ' + osDevLabel(nodeId) + ' (' + d.secs + 's) - the user got the message.', true);
                setTimeout(osRefresh, 2500);
            }).catch(function (ex) { showMsg('osMsg', 'Restart failed: ' + ex.message, false); });
        }

        function rbNotify(nodeId) {
            var m = window.prompt('Message to the logged-on user of ' + osDevLabel(nodeId) + ' (no reboot):', 'The administrator sent a maintenance notice for this device.');
            if (m === null) { return; }
            post('reboot_notify', { nodeId: nodeId, message: m }).then(function (d) {
                if (d.error) { showMsg('osMsg', d.error, false); return; }
                floatMsg('Notice sent to ' + osDevLabel(nodeId) + ' (device user informed if the platform supports it; no reboot).', true);
                setTimeout(osRefresh, 2000);
            }).catch(function (ex) { showMsg('osMsg', 'Notice failed: ' + ex.message, false); });
        }

        function osUpgradeFleet(scope) {
            var devsAll = (osApp.status && osApp.status.devices) || [];
            var n = devsAll.filter(function (x) { return x.upgradable && !x.excluded && (scope === 'all' || x.releaseState === 'urgent'); }).length;
            var unk = devsAll.filter(function (x) { return x.releaseState === 'unknown' && !x.excluded; }).length;
            var avail = devsAll.filter(function (x) { return x.upgradable && !x.excluded && x.releaseState === 'available'; }).length;
            var skipped = (unk ? '\n' + unk + ' device(s) with an UNKNOWN release state are skipped.' : '') + ((scope === 'urgent' && avail) ? '\n' + avail + ' device(s) with "Upgrade available" are not part of this batch.' : '');
            if (n === 0) { showMsg('osMsg', (scope === 'urgent' ? 'No device needs an urgent upgrade.' : 'No device is provably outdated.') + skipped.split('\n').join(' '), false); return; }
            if (!window.confirm('force OS Upgrade (' + scope + ') on ' + n + ' device(s) now?' + skipped + '\nWindows installs the current feature release, Ubuntu upgrades to the next release. This can take hours and changes the OS release. This run does not reboot a device - Windows reboots at its own automatic-restart deadline when the new release needs one.')) { return; }
            osRun('upgrade', null, scope);
        }

        // Shared per-device and fleet action wrappers (issue #9). The device list calls EXACTLY these, so one
        // place defines what an OS action asks and does - no duplicated confirmation text, no drift.
        function osDeviceUpdate(id) {
            if (window.confirm('Run OS updates on this ONE device now?\nThis run does NOT reboot - if the updates need one, Windows applies it at its automatic-restart deadline / outside active hours, or you reboot it yourself.')) { osRun('update', id); }
        }
        function osDeviceUpgrade(id) {
            if (window.confirm('Upgrade the OS release of this ONE device now? This can take hours. This run does not reboot the device itself - the device must be restarted afterwards.')) { osRun('upgrade', id); }
        }
        function wuDeviceRepair(id) {
            if (window.confirm('Apply the Windows Update troubleshooter repairs on this ONE device?\nThe WU services are restarted and the download + catroot2 folders are reset. This run does NOT reboot - a pending reboot (if any) is reported with when Windows will do it automatically.')) { wuRepair(id); }
        }
        function osFleetUpdates() {
            if (window.confirm('force OS updates on ALL non-excluded Windows and Linux devices now?\nWindows installs every pending Windows update, Linux runs the package manager upgrade. This run does not reboot - a pending reboot is reported per device and Windows handles it at its automatic-restart deadline.')) { osRun('update'); }
        }
