        function helpShow(key) {
            var box = $('helpBox');
            if (!box) { return; }
            var h = HELP[key];
            if (!h) { box.classList.remove('visible'); return; }
            $('helpTitle').textContent = h[0];
            $('helpText').textContent = h[1];
            box.classList.add('visible');
        }

        function bindHelpBox() {
            // delegated: most buttons are rendered dynamically, so binding per element would leak
            document.addEventListener('mouseover', function (e) {
                var t = e.target;
                var hops = 0;
                while (t && t !== document.body && hops < 6) {
                    if (t.getAttribute && t.getAttribute('data-help')) { helpShow(t.getAttribute('data-help')); return; }
                    t = t.parentNode; hops++;
                }
                var box = $('helpBox');
                if (box) { box.classList.remove('visible'); }
            });
            document.addEventListener('mouseleave', function () {
                var box = $('helpBox');
                if (box) { box.classList.remove('visible'); }
            });
        }
