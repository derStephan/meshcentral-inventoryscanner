        // ---------- tiny helpers ----------

        function esc(v) {
            return String((v === null || v === undefined) ? '' : v)
                .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
        }

        function $(id) { return document.getElementById(id); }

        function wgHexExit(n) { return ((n | 0) >>> 0).toString(16).toUpperCase(); }

        function post(action, data) {
            var body = 'action=' + encodeURIComponent(action);
            for (var k in data) {
                if (Object.prototype.hasOwnProperty.call(data, k)) {
                    body += '&' + encodeURIComponent(k) + '=' + encodeURIComponent(data[k]);
                }
            }
            return fetch(base, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-InvScanner-Request': '1' },
                body: body,
                credentials: 'same-origin'
            }).then(function (r) {
                if (!r.ok) { throw new Error('HTTP ' + r.status + (r.status === 404 ? ' (server plugin file looks outdated - redeploy and restart)' : '')); }
                return r.json();
            });
        }

        function get(action, params) {
            var url = base + '&action=' + encodeURIComponent(action);
            for (var k in params) {
                if (Object.prototype.hasOwnProperty.call(params, k)) {
                    url += '&' + encodeURIComponent(k) + '=' + encodeURIComponent(params[k]);
                }
            }
            // v5.5.1: the panel's GETs carry the same request header as the POSTs - a LIVE scan requires it
            return fetch(url, { credentials: 'same-origin', headers: { 'X-InvScanner-Request': '1' } }).then(function (r) {
                if (!r.ok) { throw new Error('HTTP ' + r.status); }
                return r.json();
            });
        }

        function floatMsg(text, ok) {
            var f = $('invFloat');
            if (!f) { showMsg('wgMsg', text, ok); return; }
            f.textContent = text;
            f.style.background = ok ? '#1d7a3a' : '#a33228';
            f.style.display = 'block';
            f.style.opacity = '1';
            if (window.__invFloatTimer) { clearTimeout(window.__invFloatTimer); }
            if (window.__invFloatHide) { clearTimeout(window.__invFloatHide); }
            window.__invFloatTimer = setTimeout(function () {
                f.style.opacity = '0';
                window.__invFloatHide = setTimeout(function () { f.style.display = 'none'; }, 700);
            }, 6000);
        }

        function showMsg(id, text, ok) {
            var el = $(id);
            el.textContent = text;
            el.className = ok ? 'success' : 'error';
            el.style.display = 'block';
        }

        function hideMsg(id) {
            var el = $(id);
            el.textContent = '';
            el.className = '';
            el.style.display = 'none';
        }

