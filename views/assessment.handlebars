                renderSwServerFiles();
            }).catch(function (ex) { $('swSfFolder').innerHTML = '<option value="">load failed</option>'; });
        }

        function renderSwTargets() {
            var byMesh = {};
            (swApp.devices || []).forEach(function (d) { var k = d.meshid || '?'; if (!byMesh[k]) { byMesh[k] = []; } byMesh[k].push(d); } );
            var html = '';
            (swApp.locations || []).forEach(function (loc) {
                var devs = byMesh[loc.id] || [];
                var cells = devs.map(function (d) {
