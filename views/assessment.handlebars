        // ---------- scan ----------

        function effSeverity(row) {
            if (row.assessment && row.assessment.flagged) { return 'false positive'; }
            if (row.mixed) { return String(row.severity || 'UNKNOWN').toUpperCase(); }
            if (row.assessment && row.assessment.assessment) { return String(row.assessment.assessment).toUpperCase(); }
            return String(row.severity || 'UNKNOWN').toUpperCase();
        }

        function rowRating(row) {
            if (row.mixed) { return 'MIXED'; }
            if (row.assessment && row.assessment.flagged) { return 'UNKNOWN'; }
            if (row.assessment && row.assessment.assessment) { return row.assessment.assessment; }
            return '';
        }

        function rowComment(row) {
            if (row.mixed) { return ''; }
            if (row.assessment && row.assessment.comment) { return row.assessment.comment; }
            return '';
        }

        function scan() {
            var ids = selectedLocationIds();
            if (ids.length === 0) {
                showMsg('msg', 'Select at least one location in the floating location panel.', false);
                return;
            }
            hideMsg('msg');
            $('scanBtn').disabled = true;
            $('scanStatus').textContent = 'Scanning ' + ids.length + ' location(s)...';
            get('scan', { mesh: ids.join(',') }).then(function (data) {
                $('scanBtn').disabled = false;
                $('scanStatus').textContent = '';
                if (data.error) { showMsg('msg', data.error, false); return; }
                state.rows = data.cves || [];
                renderTable();
                var n = state.rows.length;
                showMsg('msg', n + ' unique finding(s) across ' + (data.meshes ? data.meshes.length : ids.length) +
                    ' location(s). ' + (data.flaggedCount || 0) + ' flagged as false positive.', true);
            }).catch(function (e) {
                $('scanBtn').disabled = false;
                $('scanStatus').textContent = '';
                showMsg('msg', 'Scan failed: ' + e.message, false);
            });
        }

        $('scanBtn').addEventListener('click', scan);

        // ---------- findings table (sortable + filterable) ----------

        var COLUMNS = [
            { key: 'cve', label: 'CVE ID' },
            { key: 'severity', label: 'Severity' },
            { key: 'cvss', label: 'CVSS' },
            { key: 'software', label: 'Software & Version' },
            { key: 'status', label: 'Status' },
            { key: 'locations', label: 'Affected Locations / Devices' },
            { key: 'rating', label: 'Manual Rating & Comment' }
        ];

        var SEV_RANK = { 'CRITICAL': 5, 'HIGH': 4, 'MEDIUM': 3, 'LOW': 2, 'UNKNOWN': 1, 'false positive': 0 };

        function sortValue(row, key) {
            switch (key) {
                case 'severity': return SEV_RANK[effSeverity(row)] || 0;
                case 'cvss': return Number(row.cvss) || 0;
                case 'status': return (row.assessment && row.assessment.flagged && !row.mixed) ? 'false positive' : 'CVE';
                case 'rating': return rowRating(row);
                case 'comment': return rowComment(row);
                case 'locations': {
                    var names = [];
                    for (var i = 0; i < row.locations.length; i++) { names.push(row.locations[i].name); }
                    return names.join(' ');
                }
                default: return String(row[key] || '');
            }
        }

        function visibleRows() {
            var txt = state.filterText.toLowerCase().trim();
            var out = [];
            for (var i = 0; i < state.rows.length; i++) {
                var r = state.rows[i];
                if (txt) {
                    var hay = [r.cve, r.software, r.version, r.description].concat(r.variedVersions || [], r.variedSoftware || []).join(' ');
                    for (var j = 0; j < r.locations.length; j++) {
                        hay += ' ' + r.locations[j].name + ' ' + (r.locations[j].devices || []).join(' ');
                    }
                    if (hay.toLowerCase().indexOf(txt) < 0) { continue; }
                }
                if (state.filterSeverity && effSeverity(r) !== state.filterSeverity) { continue; }
                if (state.filterStatus) {
                    var isFlagged = !!(r.assessment && r.assessment.flagged && !r.mixed);
                    var isRated = !!(r.assessment && r.assessment.assessment && !r.mixed);
                    if ((state.filterStatus === 'false positive') && !isFlagged) { continue; }
                    if ((state.filterStatus === 'CVE') && isFlagged) { continue; }
                    if ((state.filterStatus === 'rated') && !isRated) { continue; }
                    if ((state.filterStatus === 'unrated') && isRated) { continue; }
                }
                out.push(r);
            }
            var key = state.sortKey, dir = (state.sortDir === 'asc') ? 1 : -1;
            out.sort(function (a, b) {
                var va = sortValue(a, key), vb = sortValue(b, key);
                if (typeof va === 'number' && typeof vb === 'number') { return (va - vb) * dir; }
                return String(va).localeCompare(String(vb)) * dir;
            });
            return out;
        }

        // Short CVE headline under the link: enough to rate without opening nvd.nist.gov,
        // the full text stays in the tooltip (v4.2.0).
        function cveNote(r) {
            var d = String(r.description || '').replace(/\s+/g, ' ').trim();
            if (d === '') { return ''; }
            var snip = (d.length > 85) ? (d.slice(0, 85).replace(/[,.;\s]*$/, '') + ' ...') : d;
            return '<div class="cvsnote" title="' + esc(d) + '">' + esc(snip) + '</div>';
        }

        function renderTable() {
            var rows = visibleRows();
            var html = '<table><thead><tr>';
            for (var c = 0; c < COLUMNS.length; c++) {
                var col = COLUMNS[c];
                var cls = col.nosort ? 'nosort' : (col.key === state.sortKey ? (state.sortDir === 'asc' ? 'sorted-asc' : 'sorted-desc') : '');
                html += '<th class="' + cls + '" data-key="' + esc(col.key) + '">' + esc(col.label) + '</th>';
            }
            html += '</tr></thead><tbody>';

            for (var i = 0; i < rows.length; i++) {
                var r = rows[i];
                var sev = effSeverity(r);
                var flagged = !!(r.assessment && r.assessment.flagged && !r.mixed);
                var status = flagged ? 'false positive' : 'CVE';
                var rating = rowRating(r);
                var comment = rowComment(r);

                html += '<tr data-cve="' + esc(r.cve) + '">';
                if (/^CVE-\d{4}-\d{4,}$/.test(r.cve)) {
                    html += '<td><a href="https://nvd.nist.gov/vuln/detail/' + esc(r.cve) + '" target="_blank" rel="noopener">' + esc(r.cve) + '</a>' + cveNote(r) + '</td>';
                } else {
                    html += '<td><b>' + esc(r.cve) + '</b>' + cveNote(r) + '</td>';
                }
                html += '<td><span class="sev sev-' + esc(sev.replace(/ /g, '-')) + '">' + esc(sev) + '</span></td>';
                html += '<td>' + esc(r.cvss) + '</td>';
                html += '<td>' + esc(r.software);
                if (r.softwareVaried && r.variedSoftware) { html += ' <span class="badge badge-varies" title="' + esc(r.variedSoftware.join(' | ')) + '">+' + (r.variedSoftware.length - 1) + ' name(s)</span>'; }
                if (r.versionVaried) { html += ' <span class="badge badge-varies" title="' + esc((r.variedVersions || []).map(function (x) { return x === '' ? 'unknown' : x; }).join(' | ')) + '">varies (' + (r.variedVersions || []).length + ')</span>'; }
                else if (r.version) { html += ' <span style="color:#556">' + esc(r.version) + '</span>'; }
                html += '</td>';
                html += '<td>' + esc(status) + (r.mixed ? ' <span class="badge badge-mixed">mixed</span>' : '') + '</td>';
                html += '<td class="devlist">';
                for (var j = 0; j < r.locations.length; j++) {
                    var loc = r.locations[j];
                    var lbls = (loc.devices || []).slice();
                    if (r.versionVaried) {
                        var dvMap = {};
                        (loc.deviceList || []).forEach(function (dl2) { dvMap[dl2.name] = dl2.version; });
                        lbls = lbls.map(function (lb) { return (dvMap[lb] != null && dvMap[lb] !== '') ? lb + ' (' + dvMap[lb] + ')' : lb; });
                    }
                    html += '<div><b>' + esc(loc.name) + '</b>: ' + esc(lbls.join(', ')) + '</div>';
                }
                html += '</td>';
                html += '<td style="min-width:230px"><select class="rating-sel">' +
                    '<option value=""' + (rating === '' ? ' selected' : '') + '>Unrated</option>' +
                    '<option value="CRITICAL"' + (rating === 'CRITICAL' ? ' selected' : '') + '>Critical</option>' +
                    '<option value="HIGH"' + (rating === 'HIGH' ? ' selected' : '') + '>High</option>' +
                    '<option value="MEDIUM"' + (rating === 'MEDIUM' ? ' selected' : '') + '>Medium</option>' +
                    '<option value="LOW"' + (rating === 'LOW' ? ' selected' : '') + '>Low</option>' +
                    '<option value="UNKNOWN"' + (rating === 'UNKNOWN' ? ' selected' : '') + '>Unknown</option>' +
                    (r.mixed ? '<option value="MIXED" selected>Mixed</option>' : '') +
                    '</select>';
                html += '<div style="margin-top:3px"><input type="text" class="comment-inp" style="width:150px" value="' + esc(comment) + '" placeholder="' + (r.mixed ? 'varies per location' : 'comment (required for rating)') + '"></div>';
                html += '<div style="margin-top:3px"><button class="small save-btn">Save Rating</button>';
                if (flagged || r.anyFlagged) {
                    html += ' <button class="small purple unfp-btn">Undo false positive</button>';
                } else {
                    html += ' <button class="small red fp-btn">Mark as False Positive</button>';
                }
                html += '</div></td>';
                html += '</tr>';
            }
            if (rows.length === 0) {
                html += '<tr><td colspan="' + COLUMNS.length + '" style="color:#888">No findings match the current filter.</td></tr>';
            }
            html += '</tbody></table>';
            $('results').innerHTML = html;
        }

        $('results').addEventListener('click', function (e) {
            var el = e.target;
            if (!el || !el.tagName || (el.tagName !== 'BUTTON')) { return; }
            var tr = el.parentNode;
            while (tr && (tr.tagName !== 'TR')) { tr = tr.parentNode; }
            if (!tr) { return; }
            var cve = tr.getAttribute('data-cve');
            if (!cve) { return; }
            var row = null;
            for (var i = 0; i < state.rows.length; i++) {
                if (state.rows[i].cve === cve) { row = state.rows[i]; break; }
            }
            if (!row) { return; }

            if (el.classList.contains('save-btn')) { saveRating(row, tr); }
            else if (el.classList.contains('fp-btn')) { flagFalsePositive(row, tr); }
            else if (el.classList.contains('unfp-btn')) { unflagFalsePositive(row, tr); }
        });

        $('results').addEventListener('click', function (e) {
            var el = e.target;
            if (el && el.tagName === 'TH' && el.getAttribute('data-key') && !el.classList.contains('nosort')) {
                var key = el.getAttribute('data-key');
                if (state.sortKey === key) { state.sortDir = (state.sortDir === 'asc') ? 'desc' : 'asc'; }
                else { state.sortKey = key; state.sortDir = (key === 'cvss' || key === 'severity') ? 'desc' : 'asc'; }
                renderTable();
            }
        });

        function rowMeshIds(row) {
            var ids = [];
            for (var i = 0; i < row.locations.length; i++) { ids.push(row.locations[i].meshId); }
            return ids.join(',');
        }

        function applyRowState(row, kind, rating, comment) {
            var perMesh = {};
            for (var i = 0; i < row.locations.length; i++) { perMesh[row.locations[i].meshId] = true; }
            if (kind === 'unflag') {
                row.assessment = null;
                row.mixed = false;
                row.anyFlagged = false;
                row.assessments = {};
            } else {
                row.mixed = false;
                row.anyFlagged = (kind === 'flag');
                row.assessment = {
                    assessment: (kind === 'flag') ? 'UNKNOWN' : rating,
                    comment: comment || '',
                    flagged: (kind === 'flag')
                };
                row.assessments = {};
                for (var meshId in perMesh) {
                    if (Object.prototype.hasOwnProperty.call(perMesh, meshId)) { row.assessments[meshId] = row.assessment; }
                }
            }
            renderTable();
        }

        function saveRating(row, tr) {
            var rating = tr.querySelector('.rating-sel').value;
            var comment = tr.querySelector('.comment-inp').value;
            if (!rating || (rating === 'MIXED')) {
                showMsg('msg', 'Please select a rating for ' + row.cve + ' first.', false);
                return;
            }
            if (!comment.trim()) {
                showMsg('msg', 'A comment is required to rate a vulnerability.', false);
                return;
            }
            post('save_assessment', { meshIds: rowMeshIds(row), cveId: row.cve, assessment: rating, comment: comment }).then(function (data) {
                if (data.error) { showMsg('msg', data.error, false); return; }
                applyRowState(row, 'save', rating, comment.trim());
                showMsg('msg', 'Rating for ' + row.cve + ' saved for ' + row.locations.length + ' location(s).', true);
            }).catch(function (e) { showMsg('msg', 'Save failed: ' + e.message, false); });
        }

        function flagFalsePositive(row, tr) {
            var comment = tr.querySelector('.comment-inp').value;
            post('flag_false_positive', { meshIds: rowMeshIds(row), cveId: row.cve, comment: comment || '' }).then(function (data) {
                if (data.error) { showMsg('msg', data.error, false); return; }
                applyRowState(row, 'flag', 'UNKNOWN', (comment || '').trim());
                showMsg('msg', row.cve + ' marked as false positive for ' + row.locations.length + ' location(s).', true);
            }).catch(function (e) { showMsg('msg', 'Action failed: ' + e.message, false); });
        }

        function unflagFalsePositive(row, tr) {
            post('unflag_false_positive', { meshIds: rowMeshIds(row), cveId: row.cve }).then(function (data) {
                if (data.error) { showMsg('msg', data.error, false); return; }
                applyRowState(row, 'unflag');
                showMsg('msg', 'False-positive flag removed for ' + row.cve + '.', true);
            }).catch(function (e) { showMsg('msg', 'Action failed: ' + e.message, false); });
        }

        // ---------- filters ----------

        $('filterText').addEventListener('input', function () {
            state.filterText = this.value;
            renderTable();
        });
        $('filterSeverity').addEventListener('change', function () {
            state.filterSeverity = this.value;
            renderTable();
        });
        $('filterStatus').addEventListener('change', function () {
            state.filterStatus = this.value;
            renderTable();
        });

        // ---------- CPE mapping table ----------

        function renderCpeTable() {
            var txt = state.cpeFilter.toLowerCase().trim();
            var html = '';
            var shown = 0;
            for (var i = 0; i < state.cpeEntries.length; i++) {
                var e = state.cpeEntries[i];
                if (txt) {
                    var hay = (e.match + ' ' + e.vendor + ' ' + e.product).toLowerCase();
                    if (hay.indexOf(txt) < 0) { continue; }
                }
                shown++;
                html += '<tr data-match="' + esc(e.match) + '" data-vendor="' + esc(e.vendor) + '" data-product="' + esc(e.product) + '">';
                html += '<td><code>' + esc(e.match) + '</code></td>';
                html += '<td>' + esc(e.vendor) + '</td>';
                html += '<td>' + esc(e.product) + '</td>';
                if (e.source === 'custom') {
                    html += '<td><span class="badge badge-custom">Custom</span></td>';
                    html += '<td><button class="small red del-cpe-btn">Delete</button></td>';
                } else {
                    html += '<td><span class="badge badge-builtin">Remote</span></td>';
                    html += '<td><button class="small override-cpe-btn">Override</button></td>';
                }
                html += '</tr>';
            }
            if (shown === 0) {
                html = '<tr><td colspan="5" style="color:#888">No mappings match the filter.</td></tr>';
            }
            $('cpeTableBody').innerHTML = html;
        }

        function loadCpeTable() {
            post('get_cpe_table', {}).then(function (data) {
                if (data.error) { showMsg('cpeMsg', data.error, false); return; }
                state.cpeEntries = data.entries || [];
                var ct = data.cpeTable || {};
                var csi = $('cpeTableSourceInfo');
            if (csi) { csi.innerHTML = (ct.source === 'remote')
                    ? ('Active table: maintained CPE table - ' + (ct.origin === 'downloaded' ? 'downloaded from ' + esc(ct.url || '') : (ct.origin === 'bundled' ? 'copy shipped with the plugin' : 'local copy on this server (refreshed from ' + esc(ct.url || '') + ')')) + ' (updated ' + esc(ct.updated || '?') + ')' + (ct.enabled ? '' : ' - automatic refresh is OFF'))
                    : ('No mapping table file could be loaded on this server - only custom entries and the automatic matcher (Auto-map) apply. Check the URL/refresh setting below or reinstall the plugin (it ships cpe-table.json).'); }
                renderCpeTable();
            }).catch(function (e) { showMsg('cpeMsg', 'Failed to load the CPE table: ' + e.message, false); });
        }

        $('cpeFilter').addEventListener('input', function () {
            state.cpeFilter = this.value;
            renderCpeTable();
        });

        $('cpeTableBody').addEventListener('click', function (e) {
            var el = e.target;
            if (!el || !el.tagName || (el.tagName !== 'BUTTON')) { return; }
            var tr = el.parentNode;
            while (tr && (tr.tagName !== 'TR')) { tr = tr.parentNode; }
            if (!tr) { return; }
            var match = tr.getAttribute('data-match');
            var vendor = tr.getAttribute('data-vendor');
            var product = tr.getAttribute('data-product');

            if (el.classList.contains('del-cpe-btn')) {
                if (!window.confirm('Delete the custom mapping "' + match + '" -> ' + vendor + '/' + product + '?')) { return; }
                post('delete_cpe_table', { match: match, vendor: vendor, product: product }).then(function (data) {
                    if (data.error) { showMsg('cpeMsg', data.error, false); return; }
                    showMsg('cpeMsg', 'Custom mapping deleted.', true);
                    loadCpeTable();
                }).catch(function (err) { showMsg('cpeMsg', 'Delete failed: ' + err.message, false); });
            } else if (el.classList.contains('override-cpe-btn')) {
                $('cpeRegex').value = match;
                $('cpeVendor').value = vendor;
                $('cpeProduct').value = product;
                $('cpeProduct').focus();
                showMsg('cpeMsg', 'Values copied to the form below. Adjust them and press Add - your custom entry takes precedence over the maintained table.', true);
            }
        });

        $('addCpeBtn').addEventListener('click', function () {
            var match = $('cpeRegex').value.trim();
            var vendor = $('cpeVendor').value.trim().toLowerCase();
            var product = $('cpeProduct').value.trim().toLowerCase();
            if (!match || !vendor || !product) {
                showMsg('cpeMsg', 'Regex, vendor and product are required.', false);
                return;
            }
            try { new RegExp(match, 'i'); } catch (err) {
                showMsg('cpeMsg', 'Invalid regex: ' + err.message, false);
                return;
            }
            post('add_cpe', { match: match, vendor: vendor, product: product }).then(function (data) {
                if (data.error) { showMsg('cpeMsg', data.error, false); return; }
                $('cpeRegex').value = '';
                $('cpeVendor').value = '';
                $('cpeProduct').value = '';
                showMsg('cpeMsg', 'Mapping saved to custom-cpe.json (takes precedence over the maintained table).', true);
                loadCpeTable();
            }).catch(function (err) { showMsg('cpeMsg', 'Save failed: ' + err.message, false); });
        });

        // ---------- Settings tab ----------

        var VALID_SEVERITIES = ['CRITICAL', 'HIGH', 'MEDIUM', 'LOW', 'UNKNOWN'];

        // Where does an effective value come from? 'file' wins over 'config.json' over 'default';
        // an overridden numeric field gets a per-key revert option in its source select.
        function applyConfigSourceUi(sel, source, revertAction) {
            if (source === 'file') {
                sel.innerHTML = '<option value="" selected>set in plugin settings</option><option value="revert">revert to config.json</option>';
            } else if (source === 'config.json') {
                sel.innerHTML = '<option value="" selected>from config.json</option>';
            } else {
                sel.innerHTML = '<option value="" selected>built-in default</option>';
            }
            sel.value = '';
            sel.onchange = function () {
                if (sel.value !== 'revert') { return; }
                var b = {};
                b[revertAction] = 'true';
                post('revert_setting', b).then(function (d) {
                    if (d.error) { showMsg('settingsMsg', d.error, false); return; }
                    showMsg('settingsMsg', 'Setting reverted - the config.json value applies again.', true);
                    loadSettings();
                }).catch(function (e) { showMsg('settingsMsg', 'Revert failed: ' + e.message, false); });
            };
        }

        function setBool(id, val) { var el = $(id); if (el) { el.checked = (val === true || val === 'true'); } }

        function loadSettings() {
            post('get_settings', {}).then(function (data) {
                if (data.error) { showMsg('settingsMsg', data.error, false); return; }
                var s = data.settings || {}, src = data.sources || {};
                if (s.notifyThreshold) { $('setNotifyThreshold').value = s.notifyThreshold; }
                setBool('setNotifyOnScan', s.notifyOnScan);
                setBool('setNotifyRepeat', s.notifyUnratedRepeat);
                setBool('setCollectOnConnect', s.collectOnAgentConnect);
                setBool('setAutoMatch', s.autoProductMatch);
                setBool('setCpeTableEnabled', s.cpeTableEnabled);
                setBool('setDistroManaged', s.distroManaged);
                setBool('setOsLifecycleEnabled', s.osLifecycleEnabled);
                if (s.osLifecycleUrl !== undefined) $('setOsLifecycleUrl').value = s.osLifecycleUrl;
                applyConfigSourceUi($('setOsLifecycleUrlSrc'), src.osLifecycleUrl, 'revertOsLifecycleUrl');
                if (s.osUpgradeUrgentDays !== undefined) $('setOsUrgentDays').value = s.osUpgradeUrgentDays;
                applyConfigSourceUi($('setOsUrgentDaysSrc'), src.osUpgradeUrgentDays, 'revertOsUpgradeUrgentDays');
                var oli = data.osLifecycle || {};
                $('osLifecycleInfo').textContent = oli.products ? ('data for ' + oli.products + ' OS families, fetched ' + fmtLocal(oli.fetched)) : 'no data yet (fetched with the next NVD refresh)';
                if (s.cpeTableUrl !== undefined) $('setCpeTableUrl').value = s.cpeTableUrl;
                applyConfigSourceUi($('setCpeTableUrlSrc'), src.cpeTableUrl, 'revertCpeTableUrl');
                if (s.scanIntervalHours !== undefined) $('setInterval').value = s.scanIntervalHours;
                applyConfigSourceUi($('setIntervalSrc'), src.scanIntervalHours, 'revertScanIntervalHours');
                if (s.updateHours !== undefined) $('setUpdateHours').value = s.updateHours;
                applyConfigSourceUi($('setUpdateHoursSrc'), src.updateHours, 'revertUpdateHours');
                if (s.anyCveMaxAgeYears !== undefined) $('setAnyAge').value = s.anyCveMaxAgeYears;
                applyConfigSourceUi($('setAnyAgeSrc'), src.anyCveMaxAgeYears, 'revertAnyCveMaxAgeYears');
                if (s.collectIntervalMinutes !== undefined) $('setCollectInterval').value = s.collectIntervalMinutes;
                applyConfigSourceUi($('setCollectIntervalSrc'), src.collectIntervalMinutes, 'revertCollectIntervalMinutes');
                loadGroupSelects(function () {
                    var sc = s.scanMeshes || [];
                    var cbs = document.querySelectorAll('.set-scan-cb');
                    for (var i = 0; i < cbs.length; i++) { cbs[i].checked = (sc.length === 0) || (sc.indexOf(cbs[i].value) >= 0); }
                    var trs = document.querySelectorAll('#groupTableBody tr');
                    var perGroup = src.notifyPerGroup || {};
                    for (var j = 0; j < trs.length; j++) {
                        var mid = trs[j].getAttribute('data-mesh');
                        var sel = trs[j].querySelector('.set-grp-thresh');
                        var srcCell = trs[j].querySelector('.grp-src');
                        if (sel && s.notify && s.notify[mid]) { sel.value = s.notify[mid]; }
                        if (srcCell) { srcCell.textContent = (perGroup[mid] === 'file') ? 'set here' : ((perGroup[mid] === 'config.json') ? 'from config.json' : ''); }
                    }
                });
            }).catch(function (e) { showMsg('settingsMsg', 'Failed to load settings: ' + e.message, false); });
        }

        function loadGroupSelects(done) {
            post('get_locations', {}).then(function (d) {
                var tb = $('groupTableBody');
                if (!tb) { done(); return; }
                var locs = (d.locations || []).slice().sort(function (a, b) { return String(a.name).localeCompare(String(b.name)); });
                var rows = '';
                for (var i = 0; i < locs.length; i++) {
                    rows += '<tr data-mesh="' + esc(locs[i].id) + '">' +
                        '<td>' + esc(locs[i].name) + '</td>' +
                        '<td><input type="checkbox" class="set-scan-cb" value="' + esc(locs[i].id) + '" checked></td>' +
                        '<td><select class="set-grp-thresh"><option value="">Global default</option>' +
                        '<option value="CRITICAL">Critical</option><option value="HIGH">High</option><option value="MEDIUM">Medium</option>' +
                        '<option value="LOW">Low</option><option value="UNKNOWN">Unknown</option></select></td>' +
                        '<td class="grp-src"></td></tr>';
                }
                if (locs.length === 0) { rows = '<tr><td colspan="4" style="color:#888">No device groups found.</td></tr>'; }
                tb.innerHTML = rows;
                done();
            }).catch(function () { done(); });
        }

        $('saveSettingsBtn').addEventListener('click', function () {
            var scanIds = [], notifyIds = [], notifySevs = [];
            var allScanCbs = document.querySelectorAll('.set-scan-cb');
            var allChecked = (allScanCbs.length > 0), anyChecked = false;
            for (var i = 0; i < allScanCbs.length; i++) {
                if (allScanCbs[i].checked) { scanIds.push(allScanCbs[i].value); anyChecked = true; } else { allChecked = false; }
            }
            var trs = document.querySelectorAll('#groupTableBody tr');
            for (var j = 0; j < trs.length; j++) {
                var mid = trs[j].getAttribute('data-mesh');
                var sevSel = trs[j].querySelector('.set-grp-thresh');
                if (mid && sevSel && sevSel.value) { notifyIds.push(mid); notifySevs.push(sevSel.value); }
            }
            var body = {
                scanIntervalHours: $('setInterval').value,
                updateHours: $('setUpdateHours').value,
                anyCveMaxAgeYears: $('setAnyAge').value,
                collectIntervalMinutes: $('setCollectInterval').value,
                notifyThreshold: $('setNotifyThreshold').value,
                notifyOnScan: $('setNotifyOnScan').checked ? 'true' : 'false',
                notifyUnratedRepeat: $('setNotifyRepeat').checked ? 'true' : 'false',
                collectOnAgentConnect: $('setCollectOnConnect').checked ? 'true' : 'false',
                autoProductMatch: $('setAutoMatch').checked ? 'true' : 'false',
                cpeTableEnabled: $('setCpeTableEnabled').checked ? 'true' : 'false',
                cpeTableUrl: $('setCpeTableUrl').value.trim(),
                distroManaged: $('setDistroManaged').checked ? 'true' : 'false',
                osLifecycleEnabled: $('setOsLifecycleEnabled').checked ? 'true' : 'false',
                osLifecycleUrl: $('setOsLifecycleUrl').value.trim(),
                osUpgradeUrgentDays: $('setOsUrgentDays').value.trim(),
                scanMeshes: (allChecked || !anyChecked) ? '' : scanIds.join(','),
                notifyMeshIds: notifyIds.join(','),
                notifySeverities: notifySevs.join(',')
            };
            post('save_settings', body).then(function (d) {
                if (d.error) { showMsg('settingsMsg', d.error, false); return; }
                showMsg('settingsMsg', 'Settings saved to scanner-settings.json and applied immediately (they override config.json).', true);
                loadSettings();
            }).catch(function (e) { showMsg('settingsMsg', 'Save failed: ' + e.message, false); });
        });

        function loadNvdLog() {
            post('get_nvdlog', {}).then(function (data) {
                if (data.error) { $('nvdLog').textContent = data.error; return; }
                $('nvdLog').textContent = (data.lines && data.lines.length) ? localizeLog(data.lines).join(String.fromCharCode(10)) : (data.note || '(empty)');
                $('nvdLogInfo').textContent = (data.note) ? data.note : (data.lines.length + ' of ' + data.size + ' bytes shown (last 200 lines) · ' + data.file);
            }).catch(function (e) { $('nvdLog').textContent = 'Failed to load the log: ' + e.message; });
        }
        $('refreshNvdLogBtn').addEventListener('click', loadNvdLog);
        loadNvdLog();

        $('updateNvdNowBtn').addEventListener('click', function () {
            if (!window.confirm('Start an NVD database update now? Missing years are downloaded and the current year refreshed.')) { return; }
            post('update_nvd', {}).then(function (d) {
                $('updateNvdInfo').textContent = d.alreadyRunning ? 'An update is already running - progress in the log below.' : 'Update started - progress in the log below.';
                loadNvdLog();
            }).catch(function (e) { showMsg('settingsMsg', 'Update request failed: ' + e.message, false); });
        });

        $('resetSettingsBtn').addEventListener('click', function () {
            if (!window.confirm('Remove ALL values saved in this tab? The settings from config.json apply again.')) { return; }
            post('save_settings', { reset: 'true' }).then(function (d) {
                if (d.error) { showMsg('settingsMsg', d.error, false); return; }
                showMsg('settingsMsg', 'Plugin settings cleared - config.json applies again.', true);
                loadSettings();
            }).catch(function (e) { showMsg('settingsMsg', 'Reset failed: ' + e.message, false); });
        });
        // ---------- init ----------

        restoreLocationSelection();
        updateLocCount();
        scan();
        loadCpeTable();
        loadSettings();
    })();
    </script>
</body>
</html>
