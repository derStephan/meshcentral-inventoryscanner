                    ack = 'true';
                }
                if (!window.confirm('RESET "' + label + '" and REMOVE EVERYTHING on it?\nThe drive is wiped and the device restarts into Windows RE. This cannot be undone. The next prompt wants the exact device name typed.')) { return; }
            } else {
