        // ---- chunked upload (urlencoded base64url stays below the server's 100kb body limit) ----

        function swRandomHex(n) {
            var a = new Uint8Array(n), i;
            if (self.crypto && crypto.getRandomValues) { crypto.getRandomValues(a); } else { for (i = 0; i < n; i++) { a[i] = Math.floor(Math.random() * 256); } }
            var out = '';
            for (i = 0; i < a.length; i++) { out += ('0' + a[i].toString(16)).slice(-2); }
            return out;
        }

        function swReadSlice(file, start, end, cb) {
            try {
                if (file.arrayBuffer) {
                    file.slice(start, end).arrayBuffer().then(function (b) { cb(null, new Uint8Array(b)); }, function (e) { cb(e); });
                    return;
                }
            } catch (e0) { }
            try {
                var r = new FileReader();
                r.onload = function () { cb(null, new Uint8Array(r.result)); };
                r.onerror = function () { cb(new Error('file read failed')); };
                r.readAsArrayBuffer(file.slice(start, end));
            } catch (e1) { cb(e1); }
        }

        function swB64url(u8) {
            var s = '', CH = 8192;
            for (var i = 0; i < u8.length; i += CH) {
                s += String.fromCharCode.apply(null, Array.prototype.slice.call(u8.subarray(i, Math.min(i + CH, u8.length))));
            }
            return btoa(s).replace(/\+/g, '-').replace(/\//g, '_');
        }

        function swUploadFile(file) {
            if (file == null) { showMsg('swMsg', 'Choose a file first.', false); return; }
            var extM = /\.([A-Za-z0-9]{1,4})$/.exec(file.name);
            var ext = extM ? extM[1].toLowerCase() : '';
            if (!extM || (swApp.limits && (swApp.limits.exts || []).indexOf(ext) < 0)) {
                showMsg('swMsg', 'Unsupported file type - allowed: ' + (((swApp.limits && swApp.limits.exts) || ['msi', 'msp', 'exe', 'deb', 'rpm', 'sh', 'bin']).join(', ')) + '.', false);
                return;
            }
            if (file.size <= 0) { showMsg('swMsg', 'The file is empty.', false); return; }
            if (swApp.limits && file.size > swApp.limits.maxBytes) { showMsg('swMsg', 'File exceeds the size limit (' + swFmtSize(swApp.limits.maxBytes) + ').', false); return; }
            var chunk = (swApp.limits && swApp.limits.chunkBytes) || 49152;
            var uploadId = swRandomHex(16);
            var size = file.size;
            var i = 0, retries = 0;
            var fail = function (msg) { $('swUploadInfo').textContent = ''; showMsg('swMsg', 'Upload failed: ' + msg, false); };
            var step = function () {
                var start = i * chunk, end = Math.min(size, start + chunk);
                $('swUploadInfo').textContent = 'Uploading ' + file.name + ' - ' + swFmtSize(end) + ' / ' + swFmtSize(size) + ' (' + Math.round(100 * end / size) + '%)';
                swReadSlice(file, start, end, function (rerr, u8) {
                    if (rerr) { fail(rerr.message); return; }
                    post('sw_upload', { uploadId: uploadId, name: file.name, index: i, data: swB64u8(u8), last: (end >= size) ? 'true' : 'false' }).then(function (d) {
                        if (d.done) { $('swUploadInfo').textContent = ''; showMsg('swMsg', '"' + d.file.name + '" is in the library (sha256 ' + String(d.file.sha256).substring(0, 16) + '...).', true); loadSwFiles(); return; }
                        if (d.error) {
                            if (retries < 6 && typeof d.next === 'number' && d.next >= 0 && d.next <= i + 1) { retries++; i = d.next; step(); return; }
                            if (retries < 6 && d.restart === true) { retries++; i = 0; step(); return; }
                            fail(d.error); return;
                        }
                        retries = 0;
                        i = (typeof d.next === 'number') ? d.next : i + 1;
                        if (start >= size && end >= size) { return; } // fully sent (the last chunk answered done)
                        step();
                    }).catch(function (ex) {
                        if (retries++ < 6) { setTimeout(step, 2500); return; } // network blip: resume at the same index
                        fail(ex.message);
                    });
                });
            };
            step();
        }

        function swB64u8(u8) { return swB64url(u8); }

