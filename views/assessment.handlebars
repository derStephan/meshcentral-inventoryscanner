        });
        $('swRefreshBtn').addEventListener('click', function () { loadSwDevices(); loadSwTasks(); loadSwLog(); });
        $('refreshSwLogBtn').addEventListener('click', loadSwLog);

        // ---------- floating location selector ----------

        function locCheckboxes() {
