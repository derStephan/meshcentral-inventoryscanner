            if (html === '') { html = '<tr><td colspan="5" style="color:#888">No deploy tasks yet.</td></tr>'; }
            $('swTaskBody').innerHTML = html;
            var runningNow = false;
            for (var k = 0; k < list.length; k++) { var cc = list[k].counts || {}; if ((cc.queued || 0) > 0 || (cc.running || 0) > 0) { runningNow = true; } }
            $('swRunInfo').textContent = runningNow ? ('tasks in progress - ' + (list.filter(function (x) { var y = x.counts || {}; return (y.queued || 0) > 0 || (y.running || 0) > 0; })).length + ' open task(s), refreshing every 10 s') : '';
