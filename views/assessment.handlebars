                var w = swfApp.wgMap[low];
                var upd = w ? '<span class="badge badge-custom">winget</span>' : (s.updatable ? '<span style="color:#888">avail</span>' : '<span style="color:#888">-</span>');
                var vuln = s.vulnerable ? dlSevBadge(s.cve || 1, s.maxSeverity) : '<span style="color:#888">none</span>';
                var lic = s.hasLicense ? '<span class="badge badge-custom">yes</span>' : '<span style="color:#888">-</span>';
                var ver = esc(s.version || '') + (s.versions > 1 ? ' <span class="badge badge-varies" title="' + s.versions + ' versions installed">+' + (s.versions - 1) + '</span>' : '');
                html += '<tr>'
                    + '<td><input type="checkbox" class="swfc" value="' + esc(low) + '" data-pkg="' + esc(w ? w.id : '') + '" data-ready="' + (w && w.ready ? '1' : '0') + '"></td>'
