                        html += '<td style="font-size:11px">' + esc(d.note || '') + (d.platform ? ' <span class="hint">(' + esc(d.platform) + ')</span>' : '') + '</td>';
                        html += '<td style="font-size:11px">' + esc(fmtLocal(d.time)) + '</td></tr>';
