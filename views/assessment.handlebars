    <div id="invFloat" style="display:none;position:fixed;top:18px;left:50%;transform:translateX(-50%);color:#fff;padding:10px 22px;border-radius:8px;z-index:9999;font-weight:600;box-shadow:0 4px 14px rgba(0,0,0,.35);transition:opacity .6s;max-width:80%;"></div>

    <div class="location-selector" id="locationPanel">
        <h4>Locations to assess</h4>
        <div id="locList">
            {{#each meshList}}
            <label class="loc-item"><input type="checkbox" class="loc-cb" value="{{this.id}}" checked> {{this.name}}</label>
            {{/each}}
        </div>
