        function drReset(id, mode) {
            var label = drDevLabel(id);
            var needAck = (mode === 'clean');
            var ack = '';
            if (mode === 'clean') {
                var d = null, ds = (drApp.status && drApp.status.devices) || [];
                for (var i = 0; i < ds.length; i++) { if (ds[i].id === id) { d = ds[i]; } }
